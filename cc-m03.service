[Unit]
Description=PTI 2802 M03 Flask Application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=Tatianaawalura
Group=Tatianaawalura
WorkingDirectory=/home/Tatianaawalura/cloud-computing
Environment="APP_ENV=development"
Environment="PYTHONUNBUFFERED=1"

ExecStart=/home/Tatianaawalura/cloud-computing/.venv/bin/gunicorn \
    --workers 1 \
    --threads 2 \
    --bind 127.0.0.1:8000 \
    --timeout 30 \
    --access-logfile - \
    --error-logfile - \
    app:app

Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
